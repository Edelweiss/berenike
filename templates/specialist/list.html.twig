{% extends 'frontend.html.twig' %}

{% block title %}Specialists | Berenike.project{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link href="{{ asset('css/jquery/ui.jqgrid.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block top %}
  Specialists
{% endblock %}

{% block body %}

  <table id="list"></table>
  <div id="pager"></div>
  
  <br />
  
  <button id="columnsHideShow" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" role="button" aria-disabled="false">
    <span class="ui-button-text">Hide/Show Columns</span>
  </button>
  <a href="{{ path('PapyrillioBerenike_AdminNewSpecialist') }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
    <span class="ui-button-text">Create New Specialist</span>
  </a>

{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('js/jquery/i18n/grid.locale-en.js') }}" type="text/javascript"></script>
  <script src="{{ asset('js/jquery/jquery-jqGrid.min.js') }}" type="text/javascript"></script>
  <script type="text/javascript">

$(function(){
  $('#list').jqGrid({
    url: '{{ path('PapyrillioBerenike_SpecialistList') }}',
    datatype: 'xml',
    mtype: 'POST',
    colNames:['Name', 'GND', 'Actions'],
    colModel :[ 
      {name:'name',     index:'name',     width:250},
      {name:'gnd',      index:'gnd',      width:150},
      {name:'actions',  index:'actions',  width:60, sortable: false, search: false}
    ],
    pager: '#pager',
    rowNum:100,
    height:'auto',
    rowList:[10,20,50,100],
    sortname: 'name',
    sortorder: 'asc',
    viewrecords: true,
    gridview: true,
    caption: null});

    $('#list').jqGrid('filterToolbar', {});
    
    $('#list').jqGrid('gridResize', {});

    $('#columnsHideShow').click(function(){
      $('#list').jqGrid('columnChooser', {shrinkToFit: false, autowidth: false});
      return false;
    });

  });

  </script>
{% endblock %}
