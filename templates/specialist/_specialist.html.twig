{% if specialist %}
  <div class="ui-widget">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">Specialist: {{ specialist.name }}</h3>
    </div>
    
    <div class="ui-widget-content ui-corner-bottom" style="padding: 0.5em;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 0.5em;">
        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Information</h4>
          <div class="ui-helper-clearfix">
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Name:</strong> {{ specialist.name }}</p>
            {% if specialist.gnd %}<p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">GND:</strong> {{ specialist.gnd }}</p>{% endif %}
          </div>
        </div>

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Related Finds</h4>
          <div class="ui-helper-clearfix">
            {% if specialist.findSpecialists|length > 0 %}
              <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 0.3em;">
                {% for findSpecialist in specialist.findSpecialists %}
                  <a href="{{ path('PapyrillioBerenike_FindShow', {'id': findSpecialist.find.id}) }}" class="ui-state-default" style="padding: 0.2em 0.4em; font-size: 0.9em; text-decoration: none; text-align: center;">
                    Find {{ findSpecialist.find.id }}
                  </a>
                {% endfor %}
              </div>
            {% else %}
              <p class="ui-state-disabled" style="padding: 0.2em; margin: 0;">No finds assigned</p>
            {% endif %}
          </div>
        </div>

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Related Images</h4>
          <div class="ui-helper-clearfix">
            {% if specialist.imageSpecialists|length > 0 %}
              <p style="padding: 0.2em; margin: 0;">{{ specialist.imageSpecialists|length }} image(s) assigned</p>
            {% else %}
              <p class="ui-state-disabled" style="padding: 0.2em; margin: 0;">No images assigned</p>
            {% endif %}
          </div>
        </div>

      </div>
    </div>
  </div>
{% endif %}
