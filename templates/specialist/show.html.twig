{% extends 'frontend.html.twig' %}

{% block title %}Specialist {{ specialist.name }} | Berenike.project{% endblock %}

{% block top %}
  Specialist: <span title="name">{{ specialist.name }}</span>
{% endblock %}

{% block body %}
  {% include 'specialist/_specialist.html.twig' with {'specialist': specialist} %}

  <div class="actions" style="margin-top: 1em;">
    {% if app.user %}
    <a href="{{ path('PapyrillioBerenike_SpecialistEdit', {'id': specialist.id}) }}"  class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Edit</span>
    </a>
    {% endif %}
    <a href="{{ path('PapyrillioBerenike_SpecialistList') }}"  class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Back to Specialists</span>
    </a>
    {% if app.user %}
    <form method="post" action="{{ path('PapyrillioBerenike_AdminDeleteSpecialist', {'id': specialist.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this specialist?');">
      <button type="submit" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" style="color: #cc0000;">
        <span class="ui-button-text">Delete</span>
      </button>
    </form>
    {% endif %}
   </div>

{% endblock %}
