{% extends 'frontend.html.twig' %}

{% block title %}
  Find {{ find.bucket.locus.excavation.site }}-{{ find.bucket.locus.excavation.season }}/{{ find.bucket.locus.excavation.trench }}/{{ find.bucket.locus.number }} {{ find.bucket.number }}
{% endblock %}

{% block top %}
  <span title="site">{{ find.bucket.locus.excavation.site }}</span><span title="season">{{ find.year|slice(-2) }}</span>-<span title="trench">{{ find.bucket.locus.excavation.trench }}</span>/<span title="locus">{% if find.bucket.locus.number == '999' %}Surface{% else %}{{ find.bucket.locus.number }}{% endif %}</span>/<span title="bucket">{% if find.bucket.number == '888' %}Block{% else %}{% if find.bucket.number == '999' %}Surface{% else %}{{ find.bucket.number }}{% endif %}{% endif %}</span>
  <small title="objectNo">{{ find.objectNo }}</small>
{% endblock %}

{% block body %}
  {% include 'find/_find.html.twig' with {'find': find} %}

  <div class="actions" style="margin-top: 1em;">
    {% if app.user %}
    <a href="{{ path('PapyrillioBerenike_FindEdit', {'id': find.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Edit</span>
    </a>
    {% endif %}
    <a href="{{ path('PapyrillioBerenike_FindList') }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Back to Finds</span>
    </a>
    {% if app.user %}
    <a href="{{ path('PapyrillioBerenike_FindShowForHeidIcon', {'id': find.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">HeidICON View</span>
    </a>
    <form method="post" action="{{ path('PapyrillioBerenike_AdminDeleteFind', {'id': find.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this find?');">
      <button type="submit" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" style="color: #cc0000;">
        <span class="ui-button-text">Delete</span>
      </button>
    </form>
    {% endif %}
  </div>
{% endblock %}
