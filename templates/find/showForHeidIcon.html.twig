{% extends 'frontend.html.twig' %}

{% block title %}
  Find {{ find.bucket.locus.excavation.site }}-{{ find.bucket.locus.excavation.season }}/{{ find.bucket.locus.excavation.trench }}/{{ find.bucket.locus.number }} {{ find.bucket.number }}
{% endblock %}

{% block top %}
  <span title="site">{{ find.bucket.locus.excavation.site }}</span><span title="season">{{ find.bucket.locus.excavation.season }}</span>-<span title="trench">{{ find.bucket.locus.excavation.trench }}</span>/<span title="locus">{{ find.bucket.locus.number }}</span>/<span title="bucket">{{ find.bucket.number }}</span>
  <span title="objectNo">{{ find.objectNo }}</span>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    function copyToClipboard(text, button) {
      navigator.clipboard.writeText(text).then(function() {
        var originalText = $(button).find('.ui-button-text').text();
        $(button).find('.ui-button-text').text('Copied!');
        setTimeout(function() {
          $(button).find('.ui-button-text').text(originalText);
        }, 1500);
      }, function(err) {
        alert('Failed to copy text');
      });
    }
  </script>
{% endblock %}

{% block body %}
  <!-- Titel -->
  <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; margin-bottom: 0.5em;">
    <h3 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.5em -0.5em 0.5em -0.5em;">Titel</h3>
    {% if find.object %}
    <p>
      <strong>Titel/Objekt:</strong> {{ find.object }}
      <button onclick="copyToClipboard('{{ find.object|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
  </div>

  <!-- Objektklassifikation -->
  <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; margin-bottom: 0.5em;">
    <h3 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.5em -0.5em 0.5em -0.5em;">Objektklassifikation</h3>
    {% if find.category %}
    <p>
      <strong>Lokale Systematik:</strong> {{ find.category }}
      <button onclick="copyToClipboard('{{ find.category|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
    {% if find.objectNo %}
    <p>
      <strong>Standardnummer:</strong> {{ find.objectNo }}
      <button onclick="copyToClipboard('{{ find.objectNo|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
  </div>

  <!-- HeidICON -->
  {% if find.heidiconId or find.heidiconUuid or find.heidiconSystemObjectId %}
  <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; margin-bottom: 0.5em;">
    <h3 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.5em -0.5em 0.5em -0.5em;">HeidICON</h3>
    {% if find.heidiconId %}
    <p>
      <strong>HeidICON ID:</strong> {{ find.heidiconId }}
      <button onclick="copyToClipboard('{{ find.heidiconId|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
    {% if find.heidiconUuid %}
    <p>
      <strong>HeidICON UUID:</strong> {{ find.heidiconUuid }}
      <button onclick="copyToClipboard('{{ find.heidiconUuid|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
    {% if find.heidiconSystemObjectId %}
    <p>
      <strong>HeidICON System Object ID:</strong> {{ find.heidiconSystemObjectId }}
      <button onclick="copyToClipboard('{{ find.heidiconSystemObjectId|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
  </div>
  {% endif %}

  <!-- Inschrift/Wasserzeichen -->
  {% if find.tm %}
  <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; margin-bottom: 0.5em;">
    <h3 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.5em -0.5em 0.5em -0.5em;">Inschrift/Wasserzeichen</h3>
    <p>
      <strong>Verweis:</strong> https://www.trismegistos.org/text/{{ find.tm }}
      <button onclick="copyToClipboard('https://www.trismegistos.org/text/{{ find.tm|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    <p>
      <strong>Linktext:</strong> <a href="https://www.trismegistos.org/text/{{ find.tm }}" target="_blank">Trismegistos</a>
      <button onclick="copyToClipboard('Trismegistos', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
  </div>
  {% endif %}

  <!-- Aufbewahrung/Standort -->
  {% if find.inventoryNumber %}
  <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; margin-bottom: 0.5em;">
    <h3 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.5em -0.5em 0.5em -0.5em;">Aufbewahrung/Standort</h3>
    <p>
      <strong>Inv.Nr./Signatur:</strong> {{ find.inventoryNumber }}
      <button onclick="copyToClipboard('{{ find.inventoryNumber|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
  </div>
  {% endif %}

  <!-- Objektbeschreibung -->
  <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; margin-bottom: 0.5em;">
    <h3 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.5em -0.5em 0.5em -0.5em;">Objektbeschreibung</h3>
    {% if find.remarks %}
    <p>
      <strong>Kommentar:</strong> {{ find.remarks }}
      <button onclick="copyToClipboard('{{ find.remarks|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
    <p>
      <strong>Beschreibung Weblink:</strong> {{ url('PapyrillioBerenike_FindShow', {'id': find.id}) }}
      <button onclick="copyToClipboard('{{ url('PapyrillioBerenike_FindShow', {'id': find.id})|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    <p>
      <strong>Linktext:</strong> <a href="{{ path('PapyrillioBerenike_FindShow', {'id': find.id}) }}">Berenike.project</a>
      <button onclick="copyToClipboard('Berenike.project', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% if find.description %}
    <p>
      <strong>Objektbeschreibung:</strong> {{ find.description }}
      <button onclick="copyToClipboard('{{ find.description|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
    {% if find.preservation %}
    <p>
      <strong>Erhaltungszustand:</strong> {{ find.preservation }}
      <button onclick="copyToClipboard('{{ find.preservation|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
  </div>

  <!-- Maß- und Formatangaben -->
  {% if find.weight or find.quantity or find.dimensions %}
  <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; margin-bottom: 0.5em;">
    <h3 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.5em -0.5em 0.5em -0.5em;">Maß- und Formatangaben (Werkteil, Format/Maße/Umfang/Dauer)</h3>
    {% if find.weight %}
    <p>
      <strong>Weight:</strong> {{ find.weight }}
      <button onclick="copyToClipboard('{{ find.weight|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
    {% if find.quantity %}
    <p>
      <strong>Quantity:</strong> {{ find.quantity }}
      <button onclick="copyToClipboard('{{ find.quantity|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
    {% if find.dimensions %}
    <p>
      <strong>Dimensions:</strong> {{ find.dimensions }}
      <button onclick="copyToClipboard('{{ find.dimensions|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
  </div>
  {% endif %}

  <!-- Herstellung/Entstehung -->
  {% if find.material or find.materialRemarks or find.datingAbsolute %}
  <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; margin-bottom: 0.5em;">
    <h3 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.5em -0.5em 0.5em -0.5em;">Herstellung/Entstehung</h3>
    {% if find.material %}
    <p>
      <strong>Material/Technik:</strong> {{ find.material }}
      <button onclick="copyToClipboard('{{ find.material|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
    {% if find.materialRemarks %}
    <p>
      <strong>Entstehungskontext:</strong> {{ find.materialRemarks }}
      <button onclick="copyToClipboard('{{ find.materialRemarks|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
    {% if find.datingAbsolute %}
    <p>
      <strong>Entstehungsdatum:</strong> {{ find.datingAbsolute }}
      <button onclick="copyToClipboard('{{ find.datingAbsolute|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
  </div>
  {% endif %}

  <!-- Publikation -->
  {% if find.publications %}
  <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; margin-bottom: 0.5em;">
    <h3 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.5em -0.5em 0.5em -0.5em;">Publikation</h3>
    <p>
      <strong>Titel der Publikation:</strong> {{ find.publications }}
      <button onclick="copyToClipboard('{{ find.publications|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
  </div>
  {% endif %}

  <!-- Fund/Ausgrabung -->
  <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; margin-bottom: 0.5em;">
    <h3 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.5em -0.5em 0.5em -0.5em;">Fund/Ausgrabung</h3>
    {% if find.trench %}
    <p>
      <strong>Fundkontext:</strong> {{ find.trench }}
      <button onclick="copyToClipboard('{{ find.trench|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
    <p>
      <strong>Fundort GND:</strong> Berenike
      <button onclick="copyToClipboard('Berenike', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% if find.date %}
    <p>
      <strong>Funddatum (normiert):</strong> {{ find.date|date('Y-m-d') }}
      <button onclick="copyToClipboard('{{ find.date|date('Y-m-d')|e('js') }}', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    {% endif %}
  </div>

  <!-- Aufnahmen/Reproduktion -->
  <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; margin-bottom: 0.5em;">
    <h3 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.5em -0.5em 0.5em -0.5em;">Aufnahmen/Reproduktion</h3>
    
    <p>
      <strong>Reproduktionstyp:</strong> Digitales Bild
      <button onclick="copyToClipboard('Digitales Bild', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>

    <p>
      <strong>Relationstyp:</strong> Object
      <button onclick="copyToClipboard('Object', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>, Reconstruction
       <button onclick="copyToClipboard('Reconstruction', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>, Field Photo
       <button onclick="copyToClipboard('Field Photo', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>, Drawing
       <button onclick="copyToClipboard('Drawing', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
    
    <p>
      <strong>Beschreibung</strong> Weitere Infos, z.B. aus dem Dateinnamen wie »Reconstruction 2 - Location Variants«
      <button onclick="copyToClipboard('Berenike', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>

    <p>
      <strong>Fotograf/Urheber (GND):</strong> …
      <button onclick="copyToClipboard('Fotograf/Urheber', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
      <br/>(falls keine GND vorhanden: »Fotograf/Urheber«)
    </p>
    
    <p>
      <strong>Kommentar (unter Inv.Nr./Signatur)</strong> Weitere Infos, z.B. aus dem Dateinnamen wie »58948_7879_a, B/W«
      <button onclick="copyToClipboard('Berenike', this)" class="ui-button ui-widget ui-state-default ui-corner-all" style="padding: 0.2em 0.4em; margin-left: 0.5em; font-size: 0.8em;">
        <span class="ui-button-text">Copy</span>
      </button>
    </p>
  </div>

  <div class="actions" style="margin-top: 1em;">
    {% if app.user %}
    <a href="{{ path('PapyrillioBerenike_FindEdit', {'id': find.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Edit</span>
    </a>
    {% endif %}
    <a href="{{ path('PapyrillioBerenike_FindList') }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Back to Finds</span>
    </a>
    {% if app.user %}
    <a href="{{ path('PapyrillioBerenike_FindShow', {'id': find.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Normal View</span>
    </a>
    <form method="post" action="{{ path('PapyrillioBerenike_AdminDeleteFind', {'id': find.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this find?');">
      <button type="submit" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" style="color: #cc0000;">
        <span class="ui-button-text">Delete</span>
      </button>
    </form>
    {% endif %}
  </div>
{% endblock %}
