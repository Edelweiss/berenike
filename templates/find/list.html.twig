{% extends 'frontend.html.twig' %}

{% block title %}Finds | Berenike.project{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link href="{{ asset('css/jquery/ui.jqgrid.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block top %}
  Liste der Funde
{% endblock %}

{% block body %}

  <table id="list"></table>
  <div id="pager"></div>
  
  <br />
  
  <button id="columnsHideShow" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" role="button" aria-disabled="false">
    <span class="ui-button-text">hide/show columns</span>
  </button>

  <button id="print" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" role="button" aria-disabled="false">
    <span class="ui-button-text">print</span>
  </button>

{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('js/jquery/i18n/grid.locale-en.js') }}" type="text/javascript"></script>
  <script src="{{ asset('js/jquery/jquery-jqGrid.min.js') }}" type="text/javascript"></script>
  <script src="{{ asset('js/correctionList.js') }}" type="text/javascript"></script>
  <script type="text/javascript">

$(function(){
  $('#list').jqGrid({
    url: '{{ path('PapyrillioBerenike_FindList') }}',
    datatype: 'xml',
    mtype: 'POST',
    colNames:[
      'TM', 'HeidICON ID', 'HeidICON UUID', 'HeidICON Sys ID', 'Trench', 'Locus', 'Bucket', 'Inventory No.', 'Date', 'Year', 'Month', 'Date Remarks',
      'SCA Register', 'Object', 'Object No', 'Category', 'Category No',
      'Weight', 'Quantity', 'Dimensions', 'Preservation', 'Description',
      'Material', 'Material Remarks', 'Dating Absolute', 'Typology Reference',
      'Publications', 'Remarks', 'Created', 'Modified', 'Actions'
    ],
    colModel :[ 
      {name:'tm',                index:'tm',                width:60},
      {name:'heidiconId',        index:'heidiconId',        width:90, hidden: true},
      {name:'heidiconUuid',      index:'heidiconUuid',      width:280, hidden: true},
      {name:'heidiconSystemObjectId', index:'heidiconSystemObjectId', width:120, hidden: true},
      {name:'trench',            index:'trench',            width:55, resizable: false},
      {name:'locus',             index:'locus',             width:55},
      {name:'bucket',            index:'bucket',            width:55},
      {name:'inventoryNumber',   index:'inventoryNumber',   width:90},
      {name:'date',              index:'date',              width:80, formatter:'date', hidden: true},
      {name:'year',              index:'year',              width:55},
      {name:'month',             index:'month',             width:55, hidden: true},
      {name:'dateRemarks',       index:'dateRemarks',       width:100, hidden: true},
      {name:'scaRegister',       index:'scaRegister',       width:90, hidden: true},
      {name:'object',            index:'object',            width:128},
      {name:'objectNo',          index:'objectNo',          width:80, hidden: true},
      {name:'category',          index:'category',          width:90, hidden: true},
      {name:'categoryNo',        index:'categoryNo',        width:80, hidden: true},
      {name:'weight',            index:'weight',            width:70, hidden: true},
      {name:'quantity',          index:'quantity',          width:70, hidden: true},
      {name:'dimensions',        index:'dimensions',        width:100, hidden: true},
      {name:'preservation',      index:'preservation',      width:100, hidden: true},
      {name:'description',       index:'description',       width:200, hidden: true},
      {name:'material',          index:'material',          width:100, hidden: true},
      {name:'materialRemarks',   index:'materialRemarks',   width:120, hidden: true},
      {name:'datingAbsolute',    index:'datingAbsolute',    width:100, hidden: true},
      {name:'typologyReference', index:'typologyReference', width:120, hidden: true},
      {name:'publications',      index:'publications',      width:120, hidden: true},
      {name:'remarks',           index:'remarks',           width:120, hidden: true},
      {name:'created',           index:'created',           width:120, hidden: true},
      {name:'modified',          index:'modified',          width:120, hidden: true},
      {name:'actions',           index:'actions',           width:85, sortable: false, search: false}
    ],
    pager: '#pager',
    rowNum:100,
    height:'auto',
    rowList:[10,20,50,100],
    sortname: 'trench',
    sortorder: 'asc',
    viewrecords: true,
    gridview: true,
    caption: null});

    $('#list').jqGrid('filterToolbar', {});
    
    $('#list').jqGrid('gridResize', {});

    $('#columnsHideShow').click(function(){
      $('#list').jqGrid('columnChooser', {shrinkToFit: false, autowidth: false});
      return false;
    });

  });

  </script>
{% endblock %}
