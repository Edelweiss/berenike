{# Shared Images Form Section #}
<div class="ui-widget" style="margin-bottom: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
        <h3 style="margin: 0; font-size: 1.1em;">Images</h3>
    </div>
    <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
    
    <!-- Section 1: Link Existing Assets -->
    <div style="margin-bottom: 2em;">
        <h4 style="margin-bottom: 0.5em;">📎 Link Existing Assets</h4>
        <p style="color: #666; font-size: 0.9em; margin-bottom: 0.5em;">
            Select one or more existing assets from the library to associate with this find.
        </p>
        {{ form_row(form.images, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
        <p style="font-size: 0.85em; color: #666; margin-top: 0.25em;">
            Hold Ctrl (or Cmd on Mac) to select multiple assets. 
            <a href="{{ path('PapyrillioBerenike_AssetList') }}" target="_blank">Browse Asset Library →</a>
        </p>
    </div>

    <!-- Section 2: Upload New Images -->
    <div>
        <h4 style="margin-bottom: 0.5em;">⬆️ Upload New Images</h4>
        <p style="color: #666; font-size: 0.9em; margin-bottom: 1em;">
            Upload new image files. They will be processed through the asset manager and linked to this find.
        </p>
        
        <div id="new-images-collection" data-prototype="{{ form_widget(form.newImageUploads.vars.prototype)|e('html_attr') }}">
            {% for uploadForm in form.newImageUploads %}
                <div class="new-image-item ui-widget-content ui-corner-all" style="padding: 1em; margin-bottom: 1em; background-color: #f9f9f9;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1em;">
                        <div>
                            {{ form_row(uploadForm.uploadedFile, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                            {{ form_row(uploadForm.type, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                        </div>
                        <div>
                            {{ form_row(uploadForm.specialist, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                            {{ form_row(uploadForm.speciality, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                            {{ form_row(uploadForm.year, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                        </div>
                    </div>
                    <div style="text-align: right; margin-top: 0.5em;">
                        <button type="button" class="remove-new-image ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
                            <span class="ui-button-text">Remove</span>
                        </button>
                    </div>
                </div>
            {% endfor %}
        </div>
        <button type="button" id="add-new-image" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
            <span class="ui-button-text">+ Add Image Upload</span>
        </button>
    </div>
    
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var newImagesCollection = document.getElementById('new-images-collection');
    var addNewImageButton = document.getElementById('add-new-image');
    
    if (!newImagesCollection || !addNewImageButton) {
        return;
    }
    
    var newImageIndex = newImagesCollection.querySelectorAll('.new-image-item').length;
    
    addNewImageButton.addEventListener('click', function() {
        var prototype = newImagesCollection.dataset.prototype;
        var newForm = prototype.replace(/__name__/g, newImageIndex);
        
        var wrapper = document.createElement('div');
        wrapper.className = 'new-image-item ui-widget-content ui-corner-all';
        wrapper.style.cssText = 'padding: 1em; margin-bottom: 1em; background-color: #f9f9f9;';
        
        // Wrap the form fields in grid layout
        wrapper.innerHTML = '<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1em;"><div>' + 
            newForm + 
            '</div><div></div></div>' +
            '<div style="text-align: right; margin-top: 0.5em;">' +
            '<button type="button" class="remove-new-image ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">' +
            '<span class="ui-button-text">Remove</span></button></div>';
        
        newImagesCollection.appendChild(wrapper);
        newImageIndex++;
    });
    newImagesCollection.addEventListener('click', function(e) {
        var target = e.target;
        if (target.classList.contains('remove-new-image') || 
            (target.classList.contains('ui-button-text') && target.textContent.trim() === 'Remove')) {
            var item = target.closest('.new-image-item');
            if (item) {
                item.remove();
            }
        }
    });
});
</script>

{# Mark fields as rendered to prevent duplicate output in form_end #}
{% do form.images.setRendered() %}
{% do form.newImageUploads.setRendered() %}
</script>

