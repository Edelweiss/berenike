{# Shared Images Form Section #}
<div class="ui-widget" style="margin-bottom: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
        <h3 style="margin: 0; font-size: 1.1em;">Images</h3>
    </div>
    <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
    
    {# Specialist prototype template with placeholders #}
    <script type="text/template" id="specialist-prototype-template">
        <div class="specialist-item" style="margin-bottom: 1em; padding: 0.5em; background-color: #f0f0f0; border-radius: 4px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5em;">
                <div>
                    <label for="find_images_IMAGEINDEX_imageSpecialists_SPECIALISTINDEX_specialist">Specialist <span style="color: red;">*</span></label>
                    <select id="find_images_IMAGEINDEX_imageSpecialists_SPECIALISTINDEX_specialist" name="find[images][IMAGEINDEX][imageSpecialists][SPECIALISTINDEX][specialist]" class="ui-widget ui-widget-content ui-corner-all" required>
                        <option value="">-- Select Specialist --</option>
                        {% for specialist in form.images.vars.prototype.imageSpecialists.vars.prototype.specialist.vars.choices %}
                            <option value="{{ specialist.value }}">{{ specialist.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="find_images_IMAGEINDEX_imageSpecialists_SPECIALISTINDEX_speciality">Speciality <span style="color: red;">*</span></label>
                    <select id="find_images_IMAGEINDEX_imageSpecialists_SPECIALISTINDEX_speciality" name="find[images][IMAGEINDEX][imageSpecialists][SPECIALISTINDEX][speciality]" class="ui-widget ui-widget-content ui-corner-all" required>
                        <option value="">-- Select Speciality --</option>
                        <option value="photographer">Photographer</option>
                        <option value="artist">Artist</option>
                    </select>
                </div>
                <div>
                    <label for="find_images_IMAGEINDEX_imageSpecialists_SPECIALISTINDEX_year">Year <span style="color: red;">*</span></label>
                    <select id="find_images_IMAGEINDEX_imageSpecialists_SPECIALISTINDEX_year" name="find[images][IMAGEINDEX][imageSpecialists][SPECIALISTINDEX][year]" class="ui-widget ui-widget-content ui-corner-all" required>
                        <option value="">-- Select Year --</option>
                        {% for year in 1995..('now'|date('Y') + 1) %}
                            <option value="{{ year }}">{{ year }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <button type="button" class="remove-specialist ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" style="margin-top: 0.5em;">
                <span class="ui-button-text">Remove Specialist</span>
            </button>
        </div>
    </script>

    <div id="images-collection" data-prototype="{{ form_widget(form.images.vars.prototype)|e('html_attr') }}">
        {% for imageForm in form.images %}
            <div class="image-item ui-widget-content ui-corner-all" style="padding: 1em; margin-bottom: 1em; background-color: #f9f9f9;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 0.5em;">
                    {{ form_row(imageForm.type, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                    {{ form_row(imageForm.number, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                    {{ form_row(imageForm.file, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                    {{ form_row(imageForm.path, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                    {{ form_row(imageForm.size, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all', 'rows': 2}}) }}
                    {{ form_row(imageForm.heidiconId, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                    {{ form_row(imageForm.heidiconUuid, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                    {{ form_row(imageForm.heidiconSystemObjectId, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                </div>

                <!-- Specialists Subsection -->
                <div style="margin-top: 1em;">
                    <h4>Specialists</h4>
                    <div class="image-specialists-collection">
                        {% for specialistForm in imageForm.imageSpecialists %}
                            <div class="specialist-item" style="margin-bottom: 1em; padding: 0.5em; background-color: #f0f0f0; border-radius: 4px;">
                                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5em;">
                                    <div>
                                        {{ form_label(specialistForm.specialist) }}
                                        {{ form_widget(specialistForm.specialist, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                                    </div>
                                    <div>
                                        {{ form_label(specialistForm.speciality) }}
                                        {{ form_widget(specialistForm.speciality, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                                    </div>
                                    <div>
                                        {{ form_label(specialistForm.year) }}
                                        {{ form_widget(specialistForm.year, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                                    </div>
                                </div>
                                <button type="button" class="remove-specialist ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" style="margin-top: 0.5em;">
                                    <span class="ui-button-text">Remove Specialist</span>
                                </button>
                            </div>
                        {% endfor %}
                    </div>
                    <button type="button" class="add-specialist ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
                        <span class="ui-button-text">Add Specialist</span>
                    </button>
                </div>
                
                <button type="button" class="remove-image ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" style="margin-top: 1em;">
                    <span class="ui-button-text">Remove Image</span>
                </button>
            </div>
        {% endfor %}
    </div>
    <button type="button" id="add-image" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
        <span class="ui-button-text">Add Image</span>
    </button>
    </div>
</div>

{# Mark images field as rendered to prevent duplicate output in form_end #}
{% do form.images.setRendered() %}
