{% if find %}
  <div class="ui-widget">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">Find {{ find.object }} {{ find.material ? '(' ~ find.material ~ ')' : ''}} {{ find.date ? find.date|date('d.m.Y') : find.year }}</h3>
    </div>
    
    <div class="ui-widget-content ui-corner-bottom" style="padding: 0.5em;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 0.5em;">
        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Basic Information</h4>
          <div class="ui-helper-clearfix">
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">ID:</strong> {{ find.id }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Inventory:</strong> {{ find.inventoryNumber }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">TM:</strong> {{ find.tm }}</p>
            {% if find.heidiconId %}
              <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">HeidICON ID:</strong> {{ find.heidiconId }}</p>
            {% endif %}
            {% if find.heidiconUuid %}
              <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">HeidICON UUID:</strong> {{ find.heidiconUuid }}</p>
            {% endif %}
            {% if find.heidiconSystemObjectId %}
              <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">HeidICON Sys ID:</strong> <a href="https://heidicon.ub.uni-heidelberg.de#/detail/{{ find.heidiconSystemObjectId }}">{{ find.heidiconSystemObjectId }}</a></p>
            {% endif %}
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Trench:</strong> {{ find.trench }}</p>
          </div>
        </div>

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Dating</h4>
          <div class="ui-helper-clearfix">
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Date:</strong> {{ find.date ? find.date|date("d.m.Y") : 'N/A' }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Year:</strong> {{ find.year }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Month:</strong> {{ find.month }}</p>
            {% if find.dateRemarks %}
              <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Remarks:</strong> {{ find.dateRemarks }}</p>
            {% endif %}
          </div>
        </div>

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Object Details</h4>
          <div class="ui-helper-clearfix">
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Object:</strong> {{ find.object }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Object No:</strong> {{ find.objectNo }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Category:</strong> {{ find.category }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Category No:</strong> {{ find.categoryNo }}</p>
          </div>
        </div>

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Physical Properties</h4>
          <div class="ui-helper-clearfix">
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Weight:</strong> {{ find.weight }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Quantity:</strong> {{ find.quantity }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Dimensions:</strong> {{ find.dimensions }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Preservation:</strong> {{ find.preservation }}</p>
          </div>
        </div>

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Material Information</h4>
          <div class="ui-helper-clearfix">
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Material:</strong> {{ find.material }}</p>
            {% if find.materialRemarks %}
              <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Remarks:</strong> {{ find.materialRemarks }}</p>
            {% endif %}
          </div>
        </div>

        {% if find.description or find.remarks %}
          <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; grid-column: 1 / -1;">
            <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Description & Remarks</h4>
            {% if find.description %}
              <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Description:</strong> {{ find.description }}</p>
            {% endif %}
            {% if find.remarks %}
              <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Remarks:</strong> {{ find.remarks }}</p>
            {% endif %}
          </div>
        {% endif %}

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">References</h4>
          <div class="ui-helper-clearfix">
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Dating:</strong> {{ find.datingAbsolute }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Typology:</strong> {{ find.typologyReference }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Publications:</strong> {{ find.publications }}</p>
          </div>
        </div>

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Specialists</h4>
          <div class="ui-helper-clearfix">
            {% if find.findSpecialists|length > 0 %}
              {% for fs in find.findSpecialists %}
                <p style="margin: 0.2em 0;">
                  <strong style="display: inline-block; width: 6em;">{% if fs.speciality %}{{ fs.speciality }}:{% else %}Specialist:{% endif %}</strong>
                  {{ fs.specialist.name }}{% if fs.year %} ({{ fs.year }}){% endif %}
                </p>
              {% endfor %}
            {% else %}
              <p class="ui-state-disabled" style="margin: 0.2em 0; padding: 0.2em;">No specialists assigned</p>
            {% endif %}
          </div>
        </div>

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">System Info</h4>
          <div class="ui-helper-clearfix">
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Created:</strong> {{ find.created|date("d.m.Y") }}</p>
            <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Modified:</strong> {{ find.modified|date("d.m.Y") }}</p>
            {% if find.rebuildChanges %}
              <p style="margin: 0.2em 0;"><strong style="display: inline-block; width: 6em;">Changes:</strong> {{ find.rebuildChanges }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div style="margin-top: 0.5em;">
    {% include 'bucket/_bucket.html.twig' with {'bucket': find.bucket} %}
  </div>
{% endif %}
