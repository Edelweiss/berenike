{% extends 'frontend.html.twig' %}

{% block title %}Edit Find{% endblock %}

{% block top %}Edit Find{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/bucket-autocomplete.css') }}">
    <style>
        .ui-widget label {
            font-weight: bold;
            display: inline-block;
            width: 12em;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.BUCKET_SEARCH_URL = '{{ path('PapyrillioBerenike_FindSearchBuckets') }}';
    </script>
    <script src="{{ asset('js/find-form-validation.js') }}"></script>
    <script src="{{ asset('js/image-collection-manager.js') }}"></script>
    <script src="{{ asset('js/bucket-autocomplete.js') }}"></script>
{% endblock %}

{% block body %}
    {{ form_start(form, {'attr': {'class': 'ui-widget', 'enctype': 'multipart/form-data'}}) }}
    <div class="ui-widget" style="margin-bottom: 1em;">
        <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
            <h3 style="margin: 0; font-size: 1.1em;">Data</h3>
        </div>
        <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1em;">
            {{ form_row(form.inventoryNumber, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.tm, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.heidiconId, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.heidiconUuid, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.heidiconSystemObjectId, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.trench, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.date, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.year, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.month, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.dateRemarks, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.scaRegister, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.object, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.objectNo, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.category, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.categoryNo, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.weight, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.quantity, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.dimensions, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.preservation, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.description, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all', 'rows': 3}}) }}
            {{ form_row(form.material, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.materialRemarks, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all', 'rows': 3}}) }}
            {{ form_row(form.datingAbsolute, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.typologyReference, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.publications, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all', 'rows': 3}}) }}
            {{ form_row(form.literature, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all', 'rows': 3}}) }}
            {{ form_row(form.remarks, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all', 'rows': 3}}) }}
            {{ form_row(form.bucketSearch, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all bucket-autocomplete'}}) }}
            {{ form_row(form.bucket, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all', 'style': 'display:none'}}) }}
        </div>
        </div>
    </div>

    <!-- Images Section -->
    {% include 'find/_images_form.html.twig' with {'form': form} %}

    <div style="margin: 1em 0;">
        <button type="submit" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
            <span class="ui-button-text">Save</span>
        </button>
        <a href="{{ path('PapyrillioBerenike_FindShow', {'id': find.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
            <span class="ui-button-text">Cancel</span>
        </a>
    </div>
    {{ form_end(form) }}
{% endblock %}