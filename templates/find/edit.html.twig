{% extends 'frontend.html.twig' %}

{% block title %}Edit Find{% endblock %}

{% block top %}Edit Find{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .ui-widget label {
            font-weight: bold;
            display: inline-block;
            width: 12em;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            var tmInput = $('input[name$="[tm]"]');
            tmInput.on('input', function() {
                var value = $(this).val();
                if (value !== '') {
                    if (parseInt(value) <= 0) {
                        this.setCustomValidity('TM must be a positive number');
                    } else {
                        this.setCustomValidity('');
                    }
                } else {
                    this.setCustomValidity(''); // Empty value is allowed
                }
            });

            // Image collection management
            var $imagesContainer = $('#images-collection');
            var imageIndex = $imagesContainer.find('.image-item').length;

            // Add new image
            $('#add-image').on('click', function(e) {
                e.preventDefault();
                
                // Get the image prototype and replace __name__ with the current index
                var imagePrototype = $imagesContainer.data('prototype');
                var newImageForm = imagePrototype.replace(/__name__/g, imageIndex);
                
                // Append the new image form
                var $newImageItem = $(newImageForm);
                $imagesContainer.append($newImageItem);
                
                // Now add one specialist to this new image
                addSpecialistToImage($newImageItem, imageIndex);
                
                imageIndex++;
            });

            // Remove image
            $imagesContainer.on('click', '.remove-image', function(e) {
                e.preventDefault();
                $(this).closest('.image-item').remove();
            });

            // Initialize existing images - add specialists functionality
            $('.image-item').each(function() {
                var $imageItem = $(this);
                // Extract the image index from existing field names
                var imageIdx = extractImageIndex($imageItem);
                setupSpecialistButtons($imageItem, imageIdx);
            });

            function extractImageIndex($imageItem) {
                var nameAttr = $imageItem.find('[name*="[images]"]').first().attr('name');
                if (nameAttr) {
                    var match = nameAttr.match(/\[images\]\[(\d+)\]/);
                    return match ? parseInt(match[1]) : 0;
                }
                return 0;
            }

            function setupSpecialistButtons($imageItem, imageIdx) {
                var $specialistsContainer = $imageItem.find('.specialists-collection');
                
                // Add specialist button click handler
                $imageItem.find('.add-specialist').off('click').on('click', function(e) {
                    e.preventDefault();
                    addSpecialistToImage($imageItem, imageIdx);
                });
            }

            function addSpecialistToImage($imageItem, imageIdx) {
                var $specialistsContainer = $imageItem.find('.image-specialists-collection');
                var specialistIndex = $specialistsContainer.find('.specialist-item').length;
                
                // Get the specialist prototype HTML from the template
                var specialistPrototypeHtml = $('#specialist-prototype-template').html();
                
                // Replace the placeholder with actual indices
                // First replace the image index placeholder
                var specialistHtml = specialistPrototypeHtml.replace(/IMAGEINDEX/g, imageIdx);
                // Then replace the specialist index placeholder
                specialistHtml = specialistHtml.replace(/SPECIALISTINDEX/g, specialistIndex);
                
                $specialistsContainer.append(specialistHtml);
            }
        });
    </script>
{% endblock %}

{% block body %}
    {{ form_start(form, {'attr': {'class': 'ui-widget'}}) }}
    <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 1em; margin-bottom: 1em;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1em;">
            {{ form_row(form.inventoryNumber, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.tm, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.heidiconId, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.heidiconUuid, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.heidiconSystemObjectId, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.trench, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.date, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.year, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.month, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.dateRemarks, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.scaRegister, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.object, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.objectNo, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.category, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.categoryNo, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.weight, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.quantity, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.dimensions, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.preservation, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.description, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all', 'rows': 3}}) }}
            {{ form_row(form.material, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.materialRemarks, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all', 'rows': 3}}) }}
            {{ form_row(form.datingAbsolute, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.typologyReference, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.publications, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all', 'rows': 3}}) }}
            {{ form_row(form.remarks, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all', 'rows': 3}}) }}
            {{ form_row(form.bucket, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
        </div>
    </div>

    <!-- Images Section -->
    <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 1em; margin-bottom: 1em;">
        <h3 style="margin-top: 0;">Images</h3>
        
        {# Specialist prototype template with placeholders #}
        <script type="text/template" id="specialist-prototype-template">
            <div class="specialist-item" style="margin-bottom: 1em; padding: 0.5em; background-color: #f0f0f0; border-radius: 4px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5em;">
                    <div>
                        <label for="find_images_IMAGEINDEX_imageSpecialists_SPECIALISTINDEX_specialist">Specialist</label>
                        <select id="find_images_IMAGEINDEX_imageSpecialists_SPECIALISTINDEX_specialist" name="find[images][IMAGEINDEX][imageSpecialists][SPECIALISTINDEX][specialist]" class="ui-widget ui-widget-content ui-corner-all">
                            <option value="">-- Select Specialist --</option>
                            {% for specialist in form.images.vars.prototype.imageSpecialists.vars.prototype.specialist.vars.choices %}
                                <option value="{{ specialist.value }}">{{ specialist.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label for="find_images_IMAGEINDEX_imageSpecialists_SPECIALISTINDEX_speciality">Speciality</label>
                        <select id="find_images_IMAGEINDEX_imageSpecialists_SPECIALISTINDEX_speciality" name="find[images][IMAGEINDEX][imageSpecialists][SPECIALISTINDEX][speciality]" class="ui-widget ui-widget-content ui-corner-all">
                            <option value="">-- Select Speciality --</option>
                            <option value="photographer">Photographer</option>
                            <option value="artist">Artist</option>
                        </select>
                    </div>
                    <div>
                        <label for="find_images_IMAGEINDEX_imageSpecialists_SPECIALISTINDEX_year">Year</label>
                        <select id="find_images_IMAGEINDEX_imageSpecialists_SPECIALISTINDEX_year" name="find[images][IMAGEINDEX][imageSpecialists][SPECIALISTINDEX][year]" class="ui-widget ui-widget-content ui-corner-all">
                            <option value="">-- Select Year --</option>
                            {% for year in 1995..('now'|date('Y') + 1) %}
                                <option value="{{ year }}">{{ year }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>
        </script>

        <div id="images-collection" data-prototype="{{ form_widget(form.images.vars.prototype)|e('html_attr') }}">
            {% for imageForm in form.images %}
                <div class="image-item ui-widget-content ui-corner-all" style="padding: 1em; margin-bottom: 1em; background-color: #f9f9f9;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 0.5em;">
                        {{ form_row(imageForm.type, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                        {{ form_row(imageForm.number, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                        {{ form_row(imageForm.file, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                        {{ form_row(imageForm.path, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                        {{ form_row(imageForm.size, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all', 'rows': 2}}) }}
                        {{ form_row(imageForm.heidiconId, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                        {{ form_row(imageForm.heidiconUuid, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                        {{ form_row(imageForm.heidiconSystemObjectId, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                    </div>

                    <!-- Specialists Subsection -->
                    <div style="margin-top: 1em;">
                        <h4>Specialists</h4>
                        <div class="specialists-collection">
                            {% for specialistForm in imageForm.imageSpecialists %}
                                <div class="specialist-item" style="margin-bottom: 1em; padding: 0.5em; background-color: #f0f0f0; border-radius: 4px;">
                                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5em;">
                                        <div>
                                            {{ form_label(specialistForm.specialist) }}
                                            {{ form_widget(specialistForm.specialist, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                                        </div>
                                        <div>
                                            {{ form_label(specialistForm.speciality) }}
                                            {{ form_widget(specialistForm.speciality, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                                        </div>
                                        <div>
                                            {{ form_label(specialistForm.year) }}
                                            {{ form_widget(specialistForm.year, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        <button type="button" class="add-specialist ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
                            <span class="ui-button-text">Add Specialist</span>
                        </button>
                    </div>
                    
                    <button type="button" class="remove-image ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" style="margin-top: 1em;">
                        <span class="ui-button-text">Remove Image</span>
                    </button>
                </div>
            {% endfor %}
        </div>
        <button type="button" id="add-image" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
            <span class="ui-button-text">Add Image</span>
        </button>
    </div>

    {# Mark images field as rendered to prevent duplicate output in form_end #}
    {% do form.images.setRendered() %}

    <div style="margin: 1em 0;">
        <button type="submit" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
            <span class="ui-button-text">Save</span>
        </button>
        <a href="{{ path('PapyrillioBerenike_FindShow', {'id': find.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
            <span class="ui-button-text">Cancel</span>
        </a>
    </div>
    {{ form_end(form) }}
{% endblock %}