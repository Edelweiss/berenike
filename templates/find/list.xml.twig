<?xml version ="1.0" encoding="utf-8"?>
<rows>
  <page>{{ page }}</page>
  <total>{{ totalPages }}</total>
  <records>{{ count }}</records>
  {% for find in finds %}
    <row id = '{{ find.id }}'>
      <cell>{{ find.id }}</cell>
      <cell>{% if find.thumbnailImage() %}{% if app.user %}<![CDATA[<a href="{{ path('PapyrillioBerenike_FindShow', {'id': find.id}) }}" title="View Find"><img src="https://heidicon.ub.uni-heidelberg.de/api/v1/objects/uuid/{{ find.thumbnailImage().heidiconUuid }}/file/id/{{ find.thumbnailImage().heidiconSystemObjectId }}/file_version/name/small" alt="Thumbnail" style="max-width: 30px; max-height: 30px; border: 1px solid #ccc; border-radius: 4px;" /></a>]]>{% else %}<![CDATA[<a href="{{ path('PapyrillioBerenike_FindShow', {'id': find.id}) }}" title="View Find"><img src="{{ asset('images/placeholder.png') }}" alt="Placeholder" style="max-width: 30px; max-height: 30px; border: 1px solid #ccc; border-radius: 4px;" /></a>]]>{% endif %}{% endif %}</cell>    
      <cell>{% if find.tm %}<![CDATA[<a href="https://www.trismegistos.org/text/{{ find.tm }}" target="_blank" title="View in Trismegistos">{{ find.tm }}</a>]]>{% endif %}</cell>
      <cell>{{ find.heidiconId }}</cell>
      <cell>{{ find.heidiconUuid }}</cell>
      <cell>{{ find.heidiconSystemObjectId }}</cell>
      <cell><![CDATA[<a href="{{ path('PapyrillioBerenike_ExcavationShow', {'id': find.bucket.locus.excavation.id}) }}" title="Trench Number {{ find.bucket.locus.excavation.trench }} {{ find.bucket.locus.excavation.season }}">{{ find.bucket.locus.excavation.trench }}</a>]]></cell>
      <cell><![CDATA[<a href="{{ path('PapyrillioBerenike_LocusShow', {'id': find.bucket.locus.id}) }}" title="Locus Number {{ find.bucket.locus.number }}">{{ find.bucket.locus.number }}</a>]]></cell>
      <cell><![CDATA[<a href="{{ path('PapyrillioBerenike_BucketShow', {'id': find.bucket.id}) }}" title="Bucket Number {{ find.bucket.number }}">{{ find.bucket.number }}</a>]]></cell>
      <cell>{{ find.inventoryNumber }}</cell>
      <cell>{{ find.date ? find.date|date('Y-m-d') : '' }}</cell>
      <cell>{{ find.year }}</cell>
      <cell>{{ find.month }}</cell>
      <cell>{{ find.dateRemarks }}</cell>
      <cell>{{ find.scaRegister }}</cell>
      <cell>{{ find.object }}</cell>
      <cell>{{ find.objectNo }}</cell>
      <cell>{{ find.category }}</cell>
      <cell>{{ find.categoryNo }}</cell>
      <cell>{{ find.weight }}</cell>
      <cell>{{ find.quantity }}</cell>
      <cell>{{ find.dimensions }}</cell>
      <cell>{{ find.preservation }}</cell>
      <cell>{{ find.description }}</cell>
      <cell>{{ find.material }}</cell>
      <cell>{{ find.materialRemarks }}</cell>
      <cell>{{ find.datingAbsolute }}</cell>
      <cell>{{ find.typologyReference }}</cell>
      <cell>{% if find.tm and find.publications %}<![CDATA[<a href="https://papyri.info/hgv/{{ find.tm }}" target="_blank" title="View in Papyri.info">{{ find.publications }}</a>]]>{% else %}{{ find.publications }}{% endif %}</cell>
      <cell>{{ find.literature }}</cell>
      <cell>{{ find.remarks }}</cell>
      <cell>{{ find.created ? find.created|date('d.m.Y H:i:s') : '' }}</cell>
      <cell>{{ find.modified ? find.modified|date('d.m.Y H:i:s') : '' }}</cell>
      <cell><![CDATA[<a href="{{ path('PapyrillioBerenike_FindShow', {'id': find.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only"><span class="ui-button-text">View</span></a>{% if app.user %}<a href="{{ path('PapyrillioBerenike_FindEdit', {'id': find.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only"><span class="ui-button-text">Edit</span></a>{% endif %}]]></cell>
    </row>
  {% endfor %}
</rows>