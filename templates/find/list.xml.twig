<?xml version ="1.0" encoding="utf-8"?>
<rows>
  <page>{{ page }}</page>
  <total>{{ totalPages }}</total>
  <records>{{ count }}</records>
  {% for find in finds %}
    <row id = '{{ find.id }}'>
      <cell>{{ find.bucket.locus.excavation.trench }}</cell>
      <cell>{{ find.bucket.locus.number }}</cell>
      <cell>{{ find.bucket.number }}</cell>
      <cell>{{ find.year }}</cell>
      <cell>{{ find.object }}</cell>
      <cell>{{ find.category }}</cell>
      <cell>{{ find.created.format('d.m.Y H:i') }}</cell>
    </row>
  {% endfor %}
</rows>