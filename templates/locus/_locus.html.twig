{% if locus %}
  <div class="ui-widget">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">Locus {{ locus.excavation.site }}{{ locus.excavation.season }}-{{ locus.excavation.trench }}/{{ locus.number }}</h3>
    </div>
    
    <div class="ui-widget-content ui-corner-bottom" style="padding: 0.5em;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 0.5em;">
        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Basic Information</h4>
          <div class="ui-helper-clearfix">
            <p style="margin: 0.2em 0;"><span class="ui-state-default" style="display: inline-block; padding: 0.2em 0.4em; margin-right: 0.3em; font-size: 0.9em;">ID</span> {{ locus.id }}</p>
            <p style="margin: 0.2em 0;"><span class="ui-state-default" style="display: inline-block; padding: 0.2em 0.4em; margin-right: 0.3em; font-size: 0.9em;">Number</span> {{ locus.number }}</p>
          </div>
        </div>

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Location</h4>
          <div class="ui-helper-clearfix">
            <p style="margin: 0.2em 0;"><span class="ui-state-default" style="display: inline-block; padding: 0.2em 0.4em; margin-right: 0.3em; font-size: 0.9em;">Site</span> {{ locus.excavation.site }}</p>
            <p style="margin: 0.2em 0;"><span class="ui-state-default" style="display: inline-block; padding: 0.2em 0.4em; margin-right: 0.3em; font-size: 0.9em;">Season</span> {{ locus.excavation.season }}</p>
            <p style="margin: 0.2em 0;"><span class="ui-state-default" style="display: inline-block; padding: 0.2em 0.4em; margin-right: 0.3em; font-size: 0.9em;">Trench</span> {{ locus.excavation.trench }}</p>
          </div>
        </div>

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em; grid-column: 1 / -1;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Description</h4>
          <div class="ui-helper-clearfix">
            {% if locus.description %}
              <p style="margin: 0.2em 0;">{{ locus.description }}</p>
            {% else %}
              <p class="ui-state-disabled" style="margin: 0.2em 0; font-style: italic;">No description available</p>
            {% endif %}
          </div>
        </div>

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">System Info</h4>
          <div class="ui-helper-clearfix">
            <p style="margin: 0.2em 0;"><span class="ui-state-default" style="display: inline-block; padding: 0.2em 0.4em; margin-right: 0.3em; font-size: 0.9em;">Created</span> {{ locus.created|date("d.m.Y") }}</p>
            <p style="margin: 0.2em 0;"><span class="ui-state-default" style="display: inline-block; padding: 0.2em 0.4em; margin-right: 0.3em; font-size: 0.9em;">Modified</span> {{ locus.modified|date("d.m.Y") }}</p>
          </div>
        </div>

        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 0.5em;">
          <h4 class="ui-widget-header ui-corner-all" style="padding: 0.3em; margin: -0.3em -0.3em 0.5em -0.3em; font-size: 0.9em;">Related Buckets</h4>
          <div class="ui-helper-clearfix">
            {% if locus.buckets|length > 0 %}
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(80px, 1fr)); gap: 0.3em;">
                {% for bucket in locus.buckets %}
                  <a href="{{ path('PapyrillioBerenike_BucketShow', {'id': bucket.id}) }}" class="ui-state-default" style="padding: 0.2em 0.4em; font-size: 0.9em; text-decoration: none; text-align: center;">
                    {{ bucket.number }}
                  </a>
                {% endfor %}
              </div>
            {% else %}
              <p class="ui-state-disabled" style="padding: 0.2em; margin: 0;">No buckets</p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}
