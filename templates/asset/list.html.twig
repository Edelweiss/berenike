{% extends 'frontend.html.twig' %}

{% block title %}Assets | Berenike.project{% endblock %}

{% block top %}Asset Library{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .asset-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1em;
      margin: 1em 0;
    }
    .asset-card {
      border: 1px solid #ccc;
      border-radius: 4px;
      overflow: hidden;
      background: #fff;
      transition: box-shadow 0.2s;
    }
    .asset-card:hover {
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    .asset-card-image {
      width: 100%;
      height: 200px;
      object-fit: cover;
      background: #f5f5f5;
      display: block;
    }
    .asset-card-body {
      padding: 0.75em;
    }
    .asset-card-title {
      font-weight: bold;
      margin: 0 0 0.5em 0;
      font-size: 0.9em;
    }
    .asset-card-meta {
      font-size: 0.85em;
      color: #666;
      margin: 0.25em 0;
    }
    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5em;
      margin: 2em 0;
    }
    .pagination a, .pagination span {
      padding: 0.5em 1em;
      border: 1px solid #ccc;
      border-radius: 4px;
      text-decoration: none;
      color: #333;
    }
    .pagination a:hover {
      background: #f0f0f0;
    }
    .pagination .current {
      background: #0073aa;
      color: #fff;
      border-color: #0073aa;
    }
  </style>
{% endblock %}

{% block body %}
  <div class="ui-widget">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">
        Assets ({{ totalAssets }} total)
        {% if app.user %}
          <a href="{{ path('PapyrillioBerenike_AssetCreate') }}" style="float: right;" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
            <span class="ui-button-text">Upload New Asset</span>
          </a>
        {% endif %}
      </h3>
    </div>

    <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
      {% if assets|length > 0 %}
        <div class="asset-grid">
          {% for asset in assets %}
            <div class="asset-card">
              <a href="{{ path('PapyrillioBerenike_AssetShow', {'id': asset.id}) }}">
                {% if asset.assetKey %}
                  <img src="{{ asset('assets/' ~ asset.assetShard ~ '/' ~ asset.assetKey ~ '/thumbnail.webp') }}" 
                       alt="{{ asset.file }}"
                       class="asset-card-image"
                       onerror="this.src='{{ asset('images/no-image.png') }}'; this.onerror=null;">
                {% else %}
                  <div class="asset-card-image" style="display: flex; align-items: center; justify-content: center; color: #999;">
                    No preview
                  </div>
                {% endif %}
              </a>
              <div class="asset-card-body">
                <h4 class="asset-card-title">
                  <a href="{{ path('PapyrillioBerenike_AssetShow', {'id': asset.id}) }}">
                    Asset #{{ asset.id }}
                  </a>
                </h4>
                <div class="asset-card-meta">
                  <strong>Type:</strong> {{ asset.type|capitalize }}
                </div>
                {% if asset.file %}
                  <div class="asset-card-meta" title="{{ asset.file }}">
                    <strong>File:</strong> {{ asset.file|length > 20 ? asset.file|slice(0, 20) ~ '...' : asset.file }}
                  </div>
                {% endif %}
                {% if asset.finds|length > 0 %}
                  <div class="asset-card-meta">
                    <strong>Finds:</strong> {{ asset.finds|length }}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        {% if totalPages > 1 %}
          <div class="pagination">
            {% if page > 1 %}
              <a href="{{ path('PapyrillioBerenike_AssetList', {'page': page - 1}) }}">« Previous</a>
            {% endif %}

            {% for p in 1..totalPages %}
              {% if p == page %}
                <span class="current">{{ p }}</span>
              {% elseif p == 1 or p == totalPages or (p >= page - 2 and p <= page + 2) %}
                <a href="{{ path('PapyrillioBerenike_AssetList', {'page': p}) }}">{{ p }}</a>
              {% elseif p == page - 3 or p == page + 3 %}
                <span>...</span>
              {% endif %}
            {% endfor %}

            {% if page < totalPages %}
              <a href="{{ path('PapyrillioBerenike_AssetList', {'page': page + 1}) }}">Next »</a>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        <p class="ui-state-disabled" style="padding: 2em; text-align: center;">
          No assets found. 
          {% if app.user %}
            <a href="{{ path('PapyrillioBerenike_AssetCreate') }}">Upload your first asset</a>.
          {% endif %}
        </p>
      {% endif %}
    </div>
  </div>

  <div style="margin-top: 1em;">
    <a href="{{ path('PapyrillioBerenike_FindList') }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Back to Finds</span>
    </a>
  </div>
{% endblock %}
