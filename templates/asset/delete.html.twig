{% extends 'frontend.html.twig' %}

{% block title %}Delete Asset #{{ asset.id }}{% endblock %}

{% block top %}Delete Asset{% endblock %}

{% block body %}
  <div class="ui-widget">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em; background-color: #cc0000; border-color: #cc0000; color: #fff;">
      <h3 style="margin: 0; font-size: 1.1em;">⚠ Confirm Deletion</h3>
    </div>

    <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
      <p style="font-size: 1.1em; margin: 1em 0;">
        Are you sure you want to delete this asset?
      </p>

      <div style="background-color: #f9f9f9; padding: 1em; border-radius: 4px; margin: 1em 0;">
        <p style="margin: 0.25em 0;"><strong>ID:</strong> {{ asset.id }}</p>
        <p style="margin: 0.25em 0;"><strong>Type:</strong> {{ asset.type|capitalize }}</p>
        <p style="margin: 0.25em 0;"><strong>File:</strong> {{ asset.file }}</p>
        <p style="margin: 0.25em 0;"><strong>Asset Key:</strong> <code>{{ asset.assetKey }}</code></p>
        {% if asset.finds|length > 0 %}
          <p style="margin: 0.25em 0;"><strong>Linked Finds:</strong> {{ asset.finds|length }}</p>
        {% endif %}
      </div>

      <div style="background-color: #fffacd; padding: 1em; border-radius: 4px; margin: 1em 0;">
        <p style="margin: 0; font-weight: bold;">Warning:</p>
        <ul style="margin: 0.5em 0; padding-left: 1.5em;">
          <li>This action will remove the database record</li>
          <li>The physical files will remain on disk (in <code>/public/assets/{{ asset.assetShard }}/{{ asset.assetKey }}/</code>)</li>
          <li>This action cannot be undone</li>
        </ul>
      </div>

      <form method="post" style="margin-top: 2em;">
        <input type="hidden" name="_token" value="{{ csrf_token('asset-delete-' ~ asset.id) }}">
        <button type="submit" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" style="background-color: #cc0000; border-color: #cc0000; color: #fff;">
          <span class="ui-button-text">Yes, Delete Asset</span>
        </button>
        <a href="{{ path('PapyrillioBerenike_AssetShow', {'id': asset.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
          <span class="ui-button-text">Cancel</span>
        </a>
      </form>
    </div>
  </div>
{% endblock %}
