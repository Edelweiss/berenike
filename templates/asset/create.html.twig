{% extends 'frontend.html.twig' %}

{% block title %}Upload New Asset{% endblock %}

{% block top %}Upload New Asset{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .ui-widget label {
      font-weight: bold;
      display: inline-block;
      width: 12em;
    }
  </style>
{% endblock %}

{% block body %}
  {# Display flash messages #}
  {% for type, messages in app.flashes %}
    {% for message in messages %}
      <div class="ui-widget" style="margin-bottom: 1em;">
        <div class="ui-state-{{ type == 'error' ? 'error' : (type == 'warning' ? 'highlight' : 'default') }} ui-corner-all" style="padding: 1em;">
          <span class="ui-icon ui-icon-{{ type == 'error' ? 'alert' : 'info' }}" style="float: left; margin-right: 0.3em;"></span>
          {{ message }}
        </div>
      </div>
    {% endfor %}
  {% endfor %}
  
  {{ form_start(form, {'attr': {'class': 'ui-widget', 'enctype': 'multipart/form-data'}}) }}
  
  {# Display form errors if any #}
  {% if form.vars.errors|length > 0 %}
    <div class="ui-widget" style="margin-bottom: 1em;">
      <div class="ui-state-error ui-corner-all" style="padding: 1em;">
        <strong>Form Errors:</strong>
        <ul>
          {% for error in form.vars.errors %}
            <li>{{ error.message }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  {% endif %}
  
  <div class="ui-widget" style="margin-bottom: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">Upload Image</h3>
    </div>
    <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
      <div style="display: grid; grid-template-columns: 1fr; gap: 1em;">
        {{ form_row(form.uploadedFile, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
        {{ form_row(form.type, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
        {{ form_row(form.number, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
      </div>
    </div>
  </div>

  <div class="ui-widget" style="margin-bottom: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">HeidICON Integration (Optional)</h3>
    </div>
    <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1em;">
        {{ form_row(form.heidiconId, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
        {{ form_row(form.heidiconUuid, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
        {{ form_row(form.heidiconSystemObjectId, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
      </div>
    </div>
  </div>

  <div style="margin: 1em 0;">
    <button type="submit" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Upload Asset</span>
    </button>
    <a href="{{ path('PapyrillioBerenike_AssetList') }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Cancel</span>
    </a>
  </div>
  
  {# Render remaining fields without labels to avoid duplication #}
  <div style="display: none;">
    {{ form_rest(form) }}
  </div>
  {{ form_end(form, {'render_rest': false}) }}
{% endblock %}
