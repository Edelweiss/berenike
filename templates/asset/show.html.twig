{% extends 'frontend.html.twig' %}

{% block title %}
  Asset #{{ asset.id }}{% if asset.finds|length > 0 %} — {{ asset.finds|length }} Find(s){% endif %}
{% endblock %}

{% block top %}
  Asset #{{ asset.id }} <small>{{ asset.type|capitalize }}{% if asset.number %} — {{ asset.number }}{% endif %}</small>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .image-viewer {
      position: relative;
      width: 100%;
      height: 600px;
      background: #1a1a1a;
      border: 1px solid #444;
      border-radius: 4px;
      overflow: hidden;
      touch-action: none;
    }
    .image-viewer .viewer-stage {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: grab;
    }
    .image-viewer .viewer-stage:active { cursor: grabbing; }
    .image-viewer img.viewer-img {
      max-width: 100%;
      max-height: 100%;
      user-select: none;
      -webkit-user-drag: none;
      transform-origin: 0 0;
      transition: transform 0.05s linear;
      display: block;
    }
    .image-viewer .viewer-controls {
      position: absolute;
      top: 0.5em;
      right: 0.5em;
      display: flex;
      gap: 0.25em;
      background: rgba(0,0,0,0.5);
      padding: 0.25em;
      border-radius: 4px;
      z-index: 10;
    }
    .image-viewer .viewer-controls button,
    .image-viewer .viewer-controls a {
      background: #fff;
      color: #222;
      border: 1px solid #888;
      padding: 0.25em 0.6em;
      font-size: 0.95em;
      cursor: pointer;
      border-radius: 3px;
      text-decoration: none;
      line-height: 1.2;
    }
    .image-viewer .viewer-controls button:hover,
    .image-viewer .viewer-controls a:hover { background: #eee; }
    .image-viewer .viewer-loading {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      color: #ccc;
      font-size: 0.9em;
    }
    .asset-meta dt { font-weight: bold; display: inline-block; width: 10em; }
    .asset-meta dd { display: inline; margin: 0; }
    .asset-meta dl > div { margin: 0.25em 0; }
  </style>
{% endblock %}

{% block body %}
  <div class="ui-widget">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">Image Viewer</h3>
    </div>

    <div class="ui-widget-content ui-corner-bottom" style="padding: 0.5em;">
      {% if asset.assetKey and asset.assetShard %}
        {% set urlThumbnail = asset('assets/' ~ asset.assetShard ~ '/' ~ asset.assetKey ~ '/thumbnail.webp') %}
        {% set urlSmall     = asset('assets/' ~ asset.assetShard ~ '/' ~ asset.assetKey ~ '/small.webp') %}
        {% set urlMedium    = asset('assets/' ~ asset.assetShard ~ '/' ~ asset.assetKey ~ '/medium.webp') %}
        {% set urlLarge     = asset('assets/' ~ asset.assetShard ~ '/' ~ asset.assetKey ~ '/large.webp') %}
        {% set urlOriginal  = asset('assets/' ~ asset.assetShard ~ '/' ~ asset.assetKey ~ '/original.tif') %}

        <div class="image-viewer" id="imageViewer">
          <div class="viewer-controls">
            <button id="zoomOut" title="Zoom out">−</button>
            <button id="zoomReset" title="Reset zoom">⊙</button>
            <button id="zoomIn" title="Zoom in">+</button>
            <select id="variantSelector" title="Image quality">
              <option value="{{ urlSmall }}">Small (640px)</option>
              <option value="{{ urlMedium }}" selected>Medium (1024px)</option>
              <option value="{{ urlLarge }}">Large (1920px)</option>
            </select>
            <a href="{{ urlOriginal }}" download="{{ asset.file }}" title="Download original TIF">⬇ TIF</a>
          </div>
          <div class="viewer-stage" id="viewerStage">
            <div class="viewer-loading">Loading...</div>
            <img class="viewer-img" id="viewerImg" data-src="{{ urlMedium }}" alt="{{ asset.file }}" style="display: none;">
          </div>
        </div>

        <script>
          (function() {
            var stage = document.getElementById('viewerStage');
            var img = document.getElementById('viewerImg');
            var loading = stage.querySelector('.viewer-loading');
            var variantSelector = document.getElementById('variantSelector');
            
            var scale = 1;
            var translateX = 0;
            var translateY = 0;
            var isDragging = false;
            var startX, startY;

            function updateTransform() {
              img.style.transform = 'translate(' + translateX + 'px, ' + translateY + 'px) scale(' + scale + ')';
            }

            function loadImage(url) {
              loading.style.display = 'block';
              img.style.display = 'none';
              var newImg = new Image();
              newImg.onload = function() {
                img.src = url;
                img.style.display = 'block';
                loading.style.display = 'none';
                scale = 1;
                translateX = 0;
                translateY = 0;
                updateTransform();
              };
              newImg.onerror = function() {
                loading.textContent = 'Failed to load image';
              };
              newImg.src = url;
            }

            // Load initial image
            loadImage(img.dataset.src);

            // Variant selector
            variantSelector.addEventListener('change', function() {
              loadImage(this.value);
            });

            // Zoom controls
            document.getElementById('zoomIn').addEventListener('click', function() {
              scale = Math.min(scale * 1.3, 10);
              updateTransform();
            });
            document.getElementById('zoomOut').addEventListener('click', function() {
              scale = Math.max(scale / 1.3, 0.1);
              updateTransform();
            });
            document.getElementById('zoomReset').addEventListener('click', function() {
              scale = 1;
              translateX = 0;
              translateY = 0;
              updateTransform();
            });

            // Mouse wheel zoom
            stage.addEventListener('wheel', function(e) {
              e.preventDefault();
              var delta = e.deltaY > 0 ? 0.9 : 1.1;
              scale = Math.max(0.1, Math.min(10, scale * delta));
              updateTransform();
            });

            // Pan controls
            stage.addEventListener('mousedown', function(e) {
              if (e.target === img) {
                isDragging = true;
                startX = e.clientX - translateX;
                startY = e.clientY - translateY;
                e.preventDefault();
              }
            });

            document.addEventListener('mousemove', function(e) {
              if (isDragging) {
                translateX = e.clientX - startX;
                translateY = e.clientY - startY;
                updateTransform();
              }
            });

            document.addEventListener('mouseup', function() {
              isDragging = false;
            });

            // Touch support
            var touchStartX, touchStartY, touchStartDist;
            stage.addEventListener('touchstart', function(e) {
              if (e.touches.length === 1) {
                isDragging = true;
                startX = e.touches[0].clientX - translateX;
                startY = e.touches[0].clientY - translateY;
              } else if (e.touches.length === 2) {
                touchStartDist = Math.hypot(
                  e.touches[0].clientX - e.touches[1].clientX,
                  e.touches[0].clientY - e.touches[1].clientY
                );
              }
              e.preventDefault();
            });

            stage.addEventListener('touchmove', function(e) {
              if (e.touches.length === 1 && isDragging) {
                translateX = e.touches[0].clientX - startX;
                translateY = e.touches[0].clientY - startY;
                updateTransform();
              } else if (e.touches.length === 2) {
                var dist = Math.hypot(
                  e.touches[0].clientX - e.touches[1].clientX,
                  e.touches[0].clientY - e.touches[1].clientY
                );
                scale = Math.max(0.1, Math.min(10, scale * (dist / touchStartDist)));
                touchStartDist = dist;
                updateTransform();
              }
              e.preventDefault();
            });

            stage.addEventListener('touchend', function() {
              isDragging = false;
            });
          })();
        </script>
      {% else %}
        <p class="ui-state-disabled" style="padding: 2em; text-align: center;">
          This is a legacy image without asset files.
        </p>
      {% endif %}
    </div>
  </div>

  <div class="ui-widget" style="margin-top: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">Metadata</h3>
    </div>

    <div class="ui-widget-content ui-corner-bottom asset-meta" style="padding: 1em;">
      <dl>
        <div><dt>ID:</dt><dd>{{ asset.id }}</dd></div>
        <div><dt>Type:</dt><dd>{{ asset.type|capitalize }}</dd></div>
        {% if asset.number %}
          <div><dt>Number:</dt><dd>{{ asset.number }}</dd></div>
        {% endif %}
        {% if asset.assetKey %}
          <div><dt>Asset Key:</dt><dd><code>{{ asset.assetKey }}</code></dd></div>
          <div><dt>Asset Shard:</dt><dd><code>{{ asset.assetShard }}</code></dd></div>
        {% endif %}
        {% if asset.file %}
          <div><dt>Original Filename:</dt><dd>{{ asset.file }}</dd></div>
        {% endif %}
        {% if asset.size %}
          <div><dt>Dimensions:</dt><dd>{{ asset.size }} pixels</dd></div>
        {% endif %}
        {% if asset.heidiconId %}
          <div><dt>HeidICON ID:</dt><dd>{{ asset.heidiconId }}</dd></div>
        {% endif %}
        {% if asset.heidiconUuid %}
          <div><dt>HeidICON UUID:</dt><dd>{{ asset.heidiconUuid }}</dd></div>
        {% endif %}
        {% if asset.heidiconSystemObjectId %}
          <div><dt>HeidICON System ID:</dt><dd><a href="https://heidicon.ub.uni-heidelberg.de#/detail/{{ asset.heidiconSystemObjectId }}" target="_blank">{{ asset.heidiconSystemObjectId }}</a></dd></div>
        {% endif %}
      </dl>
    </div>
  </div>

  {% if asset.imageSpecialists|length > 0 %}
  <div class="ui-widget" style="margin-top: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">Specialists</h3>
    </div>

    <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
      <ul style="list-style: none; padding: 0; margin: 0;">
        {% for imageSpecialist in asset.imageSpecialists %}
          <li style="margin: 0.25em 0;">
            <strong>{{ imageSpecialist.specialist.name }}</strong>
            {% if imageSpecialist.speciality %} — {{ imageSpecialist.speciality }}{% endif %}
            {% if imageSpecialist.year %} ({{ imageSpecialist.year }}){% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% endif %}

  {% if asset.finds|length > 0 %}
  <div class="ui-widget" style="margin-top: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">Linked Finds ({{ asset.finds|length }})</h3>
    </div>

    <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
      <ul style="list-style: none; padding: 0; margin: 0;">
        {% for find in asset.finds %}
          <li style="margin: 0.5em 0;">
            <a href="{{ path('PapyrillioBerenike_FindShow', {'id': find.id}) }}">
              <strong>Find #{{ find.id }}</strong>
              {% if find.inventoryNumber %} — {{ find.inventoryNumber }}{% endif %}
              {% if find.object %} — {{ find.object }}{% endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% endif %}

  <div class="actions" style="margin-top: 1em;">
    <a href="{{ path('PapyrillioBerenike_AssetList') }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">All Assets</span>
    </a>
    {% if app.user %}
    <a href="{{ path('PapyrillioBerenike_AssetEdit', {'id': asset.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Edit Metadata</span>
    </a>
    {% if asset.assetKey and is_granted('ROLE_EDITOR') %}
    <a href="{{ path('PapyrillioBerenike_AssetEditVisual', {'id': asset.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" style="background: #2196F3; color: white;">
      <span class="ui-button-text">🎨 Edit Image</span>
    </a>
    {% endif %}
    <form method="post" action="{{ path('PapyrillioBerenike_AssetDelete', {'id': asset.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this asset?');">
      <button type="submit" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" style="color: #cc0000;">
        <span class="ui-button-text">Delete</span>
      </button>
    </form>
    {% endif %}
  </div>
{% endblock %}
