{% extends 'frontend.html.twig' %}

{% block title %}Edit Asset #{{ asset.id }}{% endblock %}

{% block top %}Edit Asset Metadata{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .ui-widget label {
      font-weight: bold;
      display: inline-block;
      width: 12em;
    }
  </style>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('js/image-collection-manager.js') }}"></script>
{% endblock %}

{% block body %}
  <div class="ui-widget" style="margin-bottom: 1em;">
    <div class="ui-widget-content ui-corner-all" style="padding: 1em; background-color: #fffacd;">
      <p style="margin: 0;">
        <strong>Note:</strong> You can only edit metadata. The image files cannot be changed.
        Asset Key: <code>{{ asset.assetKey }}</code>
      </p>
    </div>
  </div>

  {{ form_start(form, {'attr': {'class': 'ui-widget'}}) }}
  <div class="ui-widget" style="margin-bottom: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">Basic Information</h3>
    </div>
    <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
      <div style="display: grid; grid-template-columns: 1fr; gap: 1em;">
        {{ form_row(form.type, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
        {{ form_row(form.number, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
      </div>
    </div>
  </div>

  <div class="ui-widget" style="margin-bottom: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">HeidICON Integration (Optional)</h3>
    </div>
    <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1em;">
        {{ form_row(form.heidiconId, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
        {{ form_row(form.heidiconUuid, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
        {{ form_row(form.heidiconSystemObjectId, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
      </div>
    </div>
  </div>

  <div class="ui-widget" style="margin-bottom: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">Link to Finds</h3>
    </div>
    <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
      {{ form_row(form.finds, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
      <p style="margin-top: 0.5em; font-size: 0.9em; color: #666;">
        Hold Ctrl (Cmd on Mac) to select multiple finds
      </p>
    </div>
  </div>

  <div class="ui-widget" style="margin-bottom: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1.1em;">Specialists</h3>
    </div>
    <div class="ui-widget-content ui-corner-bottom" style="padding: 1em;">
      <div id="specialist-collection" data-prototype="{{ form_widget(form.imageSpecialists.vars.prototype)|e('html_attr') }}">
        {% for imageSpecialist in form.imageSpecialists %}
          <div class="specialist-item" style="margin-bottom: 1em; padding: 1em; border: 1px solid #ddd; border-radius: 4px;">
            {{ form_row(imageSpecialist.specialist) }}
            {{ form_row(imageSpecialist.year) }}
            {{ form_row(imageSpecialist.speciality) }}
            <button type="button" class="remove-specialist ui-button ui-widget ui-state-default ui-corner-all" style="margin-top: 0.5em; color: #cc0000;">Remove</button>
          </div>
        {% endfor %}
      </div>
      <button type="button" id="add-specialist" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
        <span class="ui-button-text">Add Specialist</span>
      </button>
    </div>
  </div>

  <div style="margin: 1em 0;">
    <button type="submit" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Save Changes</span>
    </button>
    <a href="{{ path('PapyrillioBerenike_AssetShow', {'id': asset.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Cancel</span>
    </a>
  </div>
  {{ form_end(form) }}

  <script>
    // Collection management for specialists
    var collectionHolder = document.getElementById('specialist-collection');
    var addButton = document.getElementById('add-specialist');
    var index = collectionHolder.children.length;

    addButton.addEventListener('click', function() {
      var prototype = collectionHolder.dataset.prototype;
      var newForm = prototype.replace(/__name__/g, index);
      index++;
      
      var wrapper = document.createElement('div');
      wrapper.className = 'specialist-item';
      wrapper.style.cssText = 'margin-bottom: 1em; padding: 1em; border: 1px solid #ddd; border-radius: 4px;';
      wrapper.innerHTML = newForm + '<button type="button" class="remove-specialist ui-button ui-widget ui-state-default ui-corner-all" style="margin-top: 0.5em; color: #cc0000;">Remove</button>';
      
      collectionHolder.appendChild(wrapper);
      attachRemoveListener(wrapper.querySelector('.remove-specialist'));
    });

    function attachRemoveListener(button) {
      button.addEventListener('click', function() {
        this.closest('.specialist-item').remove();
      });
    }

    document.querySelectorAll('.remove-specialist').forEach(function(button) {
      attachRemoveListener(button);
    });
  </script>
{% endblock %}
