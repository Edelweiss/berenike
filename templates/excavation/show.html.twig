{% extends 'frontend.html.twig' %}

{% block title %}Trench {{ excavation.site }}{{ excavation.season }}-{{ excavation.trench }} | Berenike.project{% endblock %}

{% block top %}
  <span title="site">{{ excavation.site }}</span><span title="season">{{ excavation.season }}</span>-<span title="trench">{{ excavation.trench }}</span>
{% endblock %}

{% block body %}
  {% include 'excavation/_excavation.html.twig' with {'excavation': excavation} %}

  <div class="actions" style="margin-top: 1em;">
    {% if app.user %}
    <a href="{{ path('PapyrillioBerenike_ExcavationEdit', {'id': excavation.id}) }}"  class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Edit</span>
    </a>
    {% endif %}
    <a href="{{ path('PapyrillioBerenike_ExcavationList') }}"  class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Back to Trenches</span>
    </a>
    {% if app.user %}
    <form method="post" action="{{ path('PapyrillioBerenike_AdminDeleteTrench', {'id': excavation.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this trench?');">
      <button type="submit" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only" style="color: #cc0000;">
        <span class="ui-button-text">Delete</span>
      </button>
    </form>
    {% endif %}
   </div>

{% endblock %}
