{% extends 'frontend.html.twig' %}

{% block title %}Trench {{ excavation.site }}{{ excavation.season }}-{{ excavation.trench }} | Berenike.project{% endblock %}

{% block top %}
  <span title="site">{{ excavation.site }}</span><span title="season">{{ excavation.season }}</span>-<span title="trench">{{ excavation.trench }}</span>
{% endblock %}

{% block body %}
  {% include 'excavation/_excavation.html.twig' with {'excavation': excavation} %}

  <div class="actions" style="margin-top: 1em;">
    <a href="{{ path('PapyrillioBerenike_ExcavationList') }}"  class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Back to Trenches</span>
    </a>
   </div>

{% endblock %}
