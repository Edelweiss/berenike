{% extends 'frontend.html.twig' %}

{% block title %}Change Password - Berenike{% endblock %}

{% block body %}
    <div class="container">
        <h1>Change Password</h1>
        
        {% for message in app.flashes('notice') %}
            <div class="flash-notice" style="padding: 10px; margin: 10px 0; background-color: #d4edda; border: 1px solid #c3e6cb; color: #155724; border-radius: 4px;">
                {{ message }}
            </div>
        {% endfor %}
        
        {% for message in app.flashes('error') %}
            <div class="flash-error" style="padding: 10px; margin: 10px 0; background-color: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; border-radius: 4px;">
                {{ message }}
            </div>
        {% endfor %}
        
        <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 20px; margin: 20px 0;">
            <p style="margin-bottom: 20px; color: #666;">
                To change your password, please enter your current password and then enter your new password twice.
            </p>
            
            {{ form_start(form, {'attr': {'class': 'ui-form'}}) }}
                <div class="form-group" style="margin-bottom: 15px;">
                    <label for="password" class="ui-widget-header" style="display: block; padding: 5px; margin-bottom: 5px;">Current Password</label>
                    <input type="password" id="password" name="password" class="form-control" style="width: 100%; padding: 5px;" required>
                    <p style="font-size: 0.85em; color: #666; margin-top: 5px;">Enter your current password to verify your identity</p>
                </div>

                <div class="form-group" style="margin-bottom: 15px;">
                    {{ form_label(form.password.first, 'New Password', {'attr': {'class': 'ui-widget-header', 'style': 'display: block; padding: 5px; margin-bottom: 5px;'}}) }}
                    {{ form_widget(form.password.first, {'attr': {'class': 'form-control', 'style': 'width: 100%; padding: 5px;'}}) }}
                    {{ form_errors(form.password.first) }}
                </div>

                <div class="form-group" style="margin-bottom: 15px;">
                    {{ form_label(form.password.second, 'Confirm New Password', {'attr': {'class': 'ui-widget-header', 'style': 'display: block; padding: 5px; margin-bottom: 5px;'}}) }}
                    {{ form_widget(form.password.second, {'attr': {'class': 'form-control', 'style': 'width: 100%; padding: 5px;'}}) }}
                    {{ form_errors(form.password.second) }}
                    <p style="font-size: 0.85em; color: #666; margin-top: 5px;">Both new password fields must match</p>
                </div>

                <div class="form-actions" style="margin-top: 20px;">
                    <button type="submit" class="ui-button ui-widget ui-corner-all" style="padding: 8px 15px; margin-right: 10px;">
                        Change Password
                    </button>
                    <a href="{{ path('PapyrillioBerenike_UserEditProfile') }}" class="ui-button ui-widget ui-corner-all" style="padding: 8px 15px; text-decoration: none; display: inline-block;">
                        Cancel
                    </a>
                </div>
            {{ form_end(form) }}
        </div>
        
        <div class="ui-widget ui-state-highlight ui-corner-all" style="padding: 15px; margin: 20px 0;">
            <span class="ui-icon ui-icon-info" style="float: left; margin-right: 10px;"></span>
            <strong>Password Tips:</strong>
            <ul style="margin: 10px 0 0 20px;">
                <li>Use a strong password with a mix of letters, numbers, and special characters</li>
                <li>Avoid using common words or personal information</li>
                <li>Make your password at least 8 characters long</li>
                <li>Don't reuse passwords from other websites</li>
            </ul>
        </div>
    </div>
{% endblock %}
