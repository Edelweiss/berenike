{% extends 'frontend.html.twig' %}

{% block title %}Create New Specialist{% endblock %}

{% block top %}Create New Specialist{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .ui-widget label {
            font-weight: bold;
            display: inline-block;
            width: 12em;
        }
    </style>
{% endblock %}

{% block body %}
    {{ form_start(form, {'attr': {'class': 'ui-widget'}}) }}
    <div class="ui-widget ui-widget-content ui-corner-all" style="padding: 1em; margin-bottom: 1em;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1em;">
            {{ form_row(form.name, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
            {{ form_row(form.gnd, {'attr': {'class': 'ui-widget ui-widget-content ui-corner-all'}}) }}
        </div>
    </div>

    <div style="margin: 1em 0;">
        <button type="submit" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
            <span class="ui-button-text">Create</span>
        </button>
        <a href="{{ path('PapyrillioBerenike_SpecialistList') }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
            <span class="ui-button-text">Cancel</span>
        </a>
    </div>
    {{ form_end(form) }}
{% endblock %}
