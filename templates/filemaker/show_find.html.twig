{% extends 'frontend.html.twig' %}

{% block title %}
  FileMaker Find ID {{ id }} - Raw XML Data
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/default.min.css">
{% endblock %}

{% block top %}
  FileMaker Find Record - ID {{ id }}
{% endblock %}

{% block body %}
  <div class="ui-widget" style="margin-bottom: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
      <h3 style="margin: 0; font-size: 1em;">Record Data (ID: {{ id }})</h3>
    </div>
    <div class="ui-widget-content ui-corner-bottom" style="padding: 0.5em;">
      <table class="ui-widget ui-widget-content" style="width: 100%; border-collapse: collapse; font-size: 0.85em;">
        <thead>
          <tr class="ui-widget-header">
            <th style="padding: 0.2em 0.3em; text-align: left; border: 1px solid #d3d3d3;">Field Name</th>
            <th style="padding: 0.2em 0.3em; text-align: left; border: 1px solid #d3d3d3;">Value</th>
            <th style="padding: 0.2em 0.3em; text-align: left; border: 1px solid #d3d3d3;">Field Name</th>
            <th style="padding: 0.2em 0.3em; text-align: left; border: 1px solid #d3d3d3;">Value</th>
          </tr>
        </thead>
        <tbody>
          {% set fields = recordData|keys %}
          {% set half = (fields|length / 2)|round(0, 'ceil') %}
          {% for i in 0..half-1 %}
          <tr style="{% if i is odd %}background-color: #f9f9f9;{% endif %}">
            <td style="padding: 0.2em 0.3em; border: 1px solid #d3d3d3; font-weight: bold; vertical-align: top; width: 20%;">
              {{ fields[i] }}
            </td>
            <td style="padding: 0.2em 0.3em; border: 1px solid #d3d3d3; vertical-align: top; white-space: pre-wrap; word-break: break-word; width: 30%;">
              {{ recordData[fields[i]]|nl2br }}
            </td>
            {% if fields[i + half] is defined %}
            <td style="padding: 0.2em 0.3em; border: 1px solid #d3d3d3; font-weight: bold; vertical-align: top; width: 20%;">
              {{ fields[i + half] }}
            </td>
            <td style="padding: 0.2em 0.3em; border: 1px solid #d3d3d3; vertical-align: top; white-space: pre-wrap; word-break: break-word; width: 30%;">
              {{ recordData[fields[i + half]]|nl2br }}
            </td>
            {% else %}
            <td style="padding: 0.2em 0.3em; border: 1px solid #d3d3d3;"></td>
            <td style="padding: 0.2em 0.3em; border: 1px solid #d3d3d3;"></td>
            {% endif %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

<div class="ui-widget" style="margin-bottom: 1em;">
    <div class="ui-widget-header ui-corner-top" style="padding: 0.3em;">
        <h3 style="margin: 0; font-size: 1em;">Raw XML</h3>
    </div>
    <div class="ui-widget-content ui-corner-bottom" style="padding: 0.5em;">
        <pre style="margin: 0; max-height: 500px; overflow: auto;"><code class="language-xml">{{ rawXml|e }}</code></pre>
    </div>
</div>
  <div class="actions" style="margin-top: 1em;">
    <a href="{{ path('PapyrillioBerenike_FileMakerFinds') }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Back to FileMaker Finds</span>
    </a>
    <a href="{{ path('PapyrillioBerenike_FindList') }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Back to Database Finds</span>
    </a>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/xml.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', (event) => {
      document.querySelectorAll('pre code').forEach((block) => {
        hljs.highlightElement(block);
      });
    });
  </script>
{% endblock %}