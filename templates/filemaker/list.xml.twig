<?xml version ="1.0" encoding="utf-8"?>
<rows>
  <page>{{ page }}</page>
  <total>{{ totalPages }}</total>
  <records>{{ count }}</records>
  {% for find in finds %}
    <row id = '{{ find.id }}'>
      <cell>{{ find.id }}</cell>
      <cell>{% if find.bucket is defined and find.bucket %}{% if find.bucket.locus is defined and find.bucket.locus.excavation is defined %}<![CDATA[{% if find.bucket.locus.excavation.id > 0 %}<a href="{{ path('PapyrillioBerenike_ExcavationShow', {'id': find.bucket.locus.excavation.id}) }}" title="Trench Number {{ find.bucket.locus.excavation.trench }} {{ find.bucket.locus.excavation.season }}">{{ find.bucket.locus.excavation.trench }}</a>{% else %}{{ find.bucket.locus.excavation.trench }}{% endif %}]]>{% endif %}{% endif %}</cell>
      <cell>{% if find.bucket is defined and find.bucket %}{% if find.bucket.locus is defined %}<![CDATA[{% if find.bucket.locus.id > 0 %}<a href="{{ path('PapyrillioBerenike_LocusShow', {'id': find.bucket.locus.id}) }}" title="Locus Number {{ find.bucket.locus.number }}">{{ find.bucket.locus.number }}</a>{% else %}{{ find.bucket.locus.number }}{% endif %}]]>{% endif %}{% endif %}</cell>
      <cell>{% if find.bucket is defined and find.bucket %}<![CDATA[{% if find.bucket.id > 0 %}<a href="{{ path('PapyrillioBerenike_BucketShow', {'id': find.bucket.id}) }}" title="Bucket Number {{ find.bucket.number }}">{{ find.bucket.number }}</a>{% else %}{{ find.bucket.number }}{% endif %}]]>{% endif %}</cell>
      <cell>{{ find.date ? find.date|date('Y-m-d') : '' }}</cell>
      <cell>{{ find.scaRegister }}</cell>
      <cell>{{ find.object }}</cell>
      <cell>{{ find.objectNo }}</cell>
      <cell>{{ find.category }}</cell>
      <cell>{{ find.categoryNo }}</cell>
      <cell>{{ find.weight }}</cell>
      <cell>{{ find.quantity }}</cell>
      <cell>{{ find.dimensions }}</cell>
      <cell>{{ find.preservation }}</cell>
      <cell>{{ find.description }}</cell>
      <cell>{{ find.material }}</cell>
      <cell>{{ find.materialRemarks }}</cell>
      <cell>{{ find.datingAbsolute }}</cell>
      <cell>{{ find.typologyReference }}</cell>
      <cell>{{ find.publications }}</cell>
      <cell>{{ find.remarks }}</cell>
      <cell>{{ find.created ? find.created|date('d.m.Y H:i:s') : '' }}</cell>
      <cell>{{ find.modified ? find.modified|date('d.m.Y H:i:s') : '' }}</cell>
      <cell><![CDATA[<a href="{{ path('PapyrillioBerenike_FileMakerFindShow', {'id': find.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only"><span class="ui-button-text">View</span></a>]]></cell>
    </row>
  {% endfor %}
</rows>