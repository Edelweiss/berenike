{% extends 'frontend.html.twig' %}

{% block title %}Dashboard | Berenike.project{% endblock %}

{% block top %}
  Dashboard
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1em;
      padding: 1em;
    }
    
    .dashboard-tile {
      /* jQuery UI widget styling applied in HTML */
    }
    
    .dashboard-tile h3 {
      margin: 0;
      font-size: 1.1em;
      font-weight: normal;
    }
    
    .dashboard-tile ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    
    .dashboard-tile li {
      margin-bottom: 0.5em;
    }
    
    .find-item {
      padding: 0.5em;
      margin-bottom: 0.5em;
      border-radius: 4px;
    }
    
    .find-item strong {
      display: block;
      margin-bottom: 0.25em;
    }
  </style>
{% endblock %}

{% block body %}
  <div class="dashboard-grid">
    
    <!-- Quick Links Tile -->
    <div class="dashboard-tile ui-widget">
      <div class="ui-widget-header ui-corner-top" style="padding: 0.5em;">
        <h3>Quick Links</h3>
      </div>
      <div class="ui-widget-content ui-corner-bottom" style="padding: 0.5em;">
        <ul>
          <li><a href="{{ path('PapyrillioBerenike_FindList') }}">📋 All Finds</a></li>
          <li><a href="{{ path('PapyrillioBerenike_BucketList') }}">🪣 All Buckets</a></li>
          <li><a href="{{ path('PapyrillioBerenike_LocusList') }}">📍 All Loci</a></li>
          <li><a href="{{ path('PapyrillioBerenike_ExcavationList') }}">🏗️ All Trenches</a></li>
          <li><a href="{{ path('PapyrillioBerenike_SpecialistList') }}">📷 All Specialists</a></li>
        </ul>
      </div>
    </div>

    <!-- Selected Finds Tile -->
    <div class="dashboard-tile ui-widget">
      <div class="ui-widget-header ui-corner-top" style="padding: 0.5em;">
        <h3>Featured Finds</h3>
      </div>
      <div class="ui-widget-content ui-corner-bottom" style="padding: 0.5em;">
        {% if finds is not empty %}
          {% for find in finds %}
            <div class="find-item ui-state-default ui-corner-all">
              <strong>
                <a href="{{ path('PapyrillioBerenike_FindShow', {'id': find.id}) }}">
                  ID {{ find.id }}{% if find.inventoryNumber %} - {{ find.inventoryNumber }}{% endif %}
                </a>
              </strong>
              {% if find.object %}
                <small>{{ find.object }}</small>
              {% endif %}
              {% if find.bucket and find.bucket.locus and find.bucket.locus.excavation %}
                <small style="display: block; margin-top: 0.25em;">
                  Trench: {{ find.bucket.locus.excavation.trench }} | Locus: {{ find.bucket.locus.number }}
                </small>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          <p class="ui-state-disabled" style="font-style: italic; padding: 0.5em;">No featured finds available</p>
        {% endif %}
      </div>
    </div>

    <!-- Editor Tile -->
    {% if is_granted('ROLE_EDITOR') %}
    <div class="dashboard-tile ui-widget">
      <div class="ui-widget-header ui-corner-top" style="padding: 0.5em;">
        <h3>Edit Actions</h3>
      </div>
      <div class="ui-widget-content ui-corner-bottom" style="padding: 0.5em;">
        <ul>
          <li><a href="{{ path('PapyrillioBerenike_AdminNewFind') }}">⭐ Create new Find</a></li>
          <li><a href="{{ path('PapyrillioBerenike_AdminNewBucket') }}">⭐ Create new Bucket</a></li>
          <li><a href="{{ path('PapyrillioBerenike_AdminNewLocus') }}">⭐ Create new Locus</a></li>
          <li><a href="{{ path('PapyrillioBerenike_AdminNewTrench') }}">⭐ Create new Trench</a></li>
          <li><a href="{{ path('PapyrillioBerenike_AdminNewSpecialist') }}">⭐ Create new Specialist</a></li>
        </ul>
      </div>
    </div>
    {% endif %}

    <!-- External Resources Tile -->
    {% if is_granted('ROLE_ADMIN') %}
    <div class="dashboard-tile ui-widget">
      <div class="ui-widget-header ui-corner-top" style="padding: 0.5em;">
        <h3>External Resources</h3>
      </div>
      <div class="ui-widget-content ui-corner-bottom" style="padding: 0.5em;">
        <ul>
          <li><a href="https://github.com/Edelweiss/berenike/issues" target="_blank" rel="noopener noreferrer">🐛 GitHub Issues</a></li>
          <li><a href="https://github.com/Edelweiss/berenike/wiki" target="_blank" rel="noopener noreferrer">📖 GitHub Wiki</a></li>
          <li><a href="https://docs.google.com/spreadsheets/d/11CGc35lH0IEghwEJTflO1l0C-c7YV-Cj2SF88t05N_4/edit?usp=sharing" target="_blank" rel="noopener noreferrer">📊 Google Spreadsheet</a></li>
          <li><a href="https://heidicon.ub.uni-heidelberg.de/" target="_blank" rel="noopener noreferrer">🖼️ HeidICON</a></li>
          <li><a href="https://berenike.pcma.uw.edu.pl/" target="_blank" rel="noopener noreferrer">🌐 Berenike PCMA</a></li>
        </ul>
      </div>
    </div>
    {% endif %}

    <!-- Admin Tile -->
    {% if is_granted('ROLE_ADMIN') %}
    <div class="dashboard-tile ui-widget">
      <div class="ui-widget-header ui-corner-top" style="padding: 0.5em;">
        <h3>Admin Actions</h3>
      </div>
      <div class="ui-widget-content ui-corner-bottom" style="padding: 0.5em;">
        <ul>
          <li><a href="{{ path('PapyrillioBerenike_UserList') }}">👥 Manage Users</a></li>
          <li><a href="{{ path('PapyrillioBerenike_UserNew') }}">👤 Create new User</a></li>
        </ul>
      </div>
    </div>
    {% endif %}

    <!-- Statistics Tile -->
    <div class="dashboard-tile ui-widget">
      <div class="ui-widget-header ui-corner-top" style="padding: 0.5em;">
        <h3>Recent Activity</h3>
      </div>
      <div class="ui-widget-content ui-corner-bottom" style="padding: 0.5em;">
        <ul>
          <li>📊 Total Featured Finds: {{ finds|length }}</li>
          <li><a href="{{ path('PapyrillioBerenike_Home') }}">🔗 Go to Home</a></li>
        </ul>
      </div>
    </div>

  </div>
{% endblock %}
