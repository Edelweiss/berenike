<?xml version="1.0" encoding="UTF-8"?>
<rows>
    <page>{{ page }}</page>
    <total>{{ totalPages }}</total>
    <records>{{ count }}</records>
    {% for bucket in buckets %}
    <row id="{{ bucket.id }}">
        <cell>{{ bucket.number }}</cell>
        <cell>{{ bucket.dating }}</cell>
        <cell>{% if bucket.locus %}{{ bucket.locus.number }}{% endif %}</cell>
        <cell>{{ bucket.remarks }}</cell>
        <cell>{{ bucket.created|date('Y-m-d H:i:s') }}</cell>
        <cell>{{ bucket.modified|date('Y-m-d H:i:s') }}</cell>
        <cell><![CDATA[<a href="{{ path('PapyrillioBerenike_BucketShow', {'id': bucket.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only"><span class="ui-button-text">View</span></a><a href="{{ path('PapyrillioBerenike_BucketEdit', {'id': bucket.id}) }}" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only"><span class="ui-button-text">Edit</span></a>]]></cell>
    </row>
    {% endfor %}
</rows>
