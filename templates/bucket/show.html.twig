{% extends 'frontend.html.twig' %}

{% block title %}Bucket {{ bucket.locus.excavation.site }}{{ bucket.locus.excavation.season }}-{{ bucket.locus.excavation.trench }}/{{ bucket.locus.number }}/{{ bucket.number }} | Berenike.project{% endblock %}

{% block top %}
  <span title="site">PB {{ bucket.number }}</span>
{% endblock %}

{% block body %}
  {% include 'bucket/_bucket.html.twig' with {'bucket': bucket} %}

  <div class="actions" style="margin-top: 1em;">
    <a href="{{ path('PapyrillioBerenike_BucketList') }}" 
       class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
      <span class="ui-button-text">Back to Buckets</span>
    </a>
  </div>
{% endblock %}
