<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://raw.github.com/doctrine/doctrine2/master/doctrine-mapping.xsd">
    <entity name="App\Entity\ImageSpecialist" table="image_specialist">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="year" type="integer" nullable="true"/>
        <field name="speciality" type="string" length="512" nullable="true"/>
        <many-to-one field="image" target-entity="Image" inversed-by="imageSpecialists">
            <join-column name="image_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <many-to-one field="specialist" target-entity="Specialist" inversed-by="imageSpecialists">
            <join-column name="specialist_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
