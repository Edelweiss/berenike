<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://raw.github.com/doctrine/doctrine2/master/doctrine-mapping.xsd">
    <entity name="App\Entity\Image" table="image">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="type" type="string" length="64" nullable="false"/>
        <field name="number" type="string" length="64" nullable="true"/>
        <field name="size" type="text" nullable="false"/>
        <field name="file" type="string" length="512" nullable="false"/>
        <field name="path" type="string" length="512" nullable="false"/>
        <field name="assetKey" type="string" length="512" nullable="true"/>
        <field name="assetShard" type="string" length="2" nullable="true"/>
        <field name="heidiconId" type="integer" nullable="true">
            <options>
                <option name="unsigned">true</option>
            </options>
        </field>
        <field name="heidiconUuid" type="string" length="512" nullable="true"/>
        <field name="heidiconSystemObjectId" type="integer" nullable="true">
            <options>
                <option name="unsigned">true</option>
            </options>
        </field>
        <many-to-many field="finds" target-entity="Find" inversed-by="images">
            <join-table name="find_image">
                <join-columns>
                    <join-column name="image_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
                </join-columns>
                <inverse-join-columns>
                    <join-column name="find_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
                </inverse-join-columns>
            </join-table>
        </many-to-many>
        <one-to-many field="imageSpecialists" target-entity="ImageSpecialist" mapped-by="image" orphan-removal="true"><!-- orphan-removal to delete ImageSpecialists when removed from collection -->
            <cascade>
                <cascade-persist/>
                <cascade-remove/><!-- when image is deleted, all associated imageSpecialists are also deleted -->
            </cascade>
            <order-by>
                <order-by-field name="year" direction="ASC" />
            </order-by>
        </one-to-many>
        <!-- don't forget to init the collection in entity __construct() method -->
    </entity>
</doctrine-mapping>
